<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Immersive, no action bar, black window background. -->
    <style name="Theme.NeuralMLTerminal" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/neural_black</item>
        <item name="android:colorBackground">@color/neural_black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentTransitions">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
